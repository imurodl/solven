NODE_ENV=development
PORT_API=3007
PORT_BATCH=3008
MONGO_DEV=mongodb+srv://...
MONGO_PROD=mongodb+srv://...
SECRET_TOKEN=your-secret-token
REFRESH_SECRET=your-refresh-secret

# Comma-separated origins allowed by CORS; first https one is the OAuth redirect target
FRONTEND_URL=https://solven.uz,https://www.solven.uz
SESSION_SECRET=

# Google OAuth (console.cloud.google.com) — empty disables the Google login route
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.solven.uz/auth/google/callback

# Telegram login widget + order notifications (@BotFather) — empty disables both
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=

# Order e-mails via Resend — empty disables e-mail
RESEND_API_KEY=
MAIL_FROM=Solven <no-reply@solven.uz>

# AI: translation, photo finder, price check, description writer (Groq primary, Gemini fallback)
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_DAILY_LIMIT_MEMBER=10
AI_DAILY_LIMIT_ANON=3

# Orders
DEMO_ORDER_FLOW=true
ORDER_DEPOSIT_RATE=0.05
